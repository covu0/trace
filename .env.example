# Copy to .env.local for development. All values are required.

# Postgres connection string (Railway: from the Postgres service's Variables tab).
DATABASE_URL=postgres://user:password@host:5432/trace

# Auth.js session encryption secret. Generate with: openssl rand -base64 32
AUTH_SECRET=

# GitHub OAuth app credentials (https://github.com/settings/developers).
# Callback URL: <your-app-url>/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Anthropic API key — powers the explanation pipeline (Milestone 3+).
ANTHROPIC_API_KEY=

# Model for narrative generation. Default: claude-sonnet-4-6, thinking off
# (founder-approved cost/latency path). Set TRACE_MODEL=claude-opus-4-8 and
# TRACE_THINKING=adaptive for quality A/Bs.
# TRACE_MODEL=claude-sonnet-4-6
# TRACE_THINKING=adaptive

# Spend protection: LLM-invoking queries per UTC day. Gated (zero-token)
# queries never count. Global cap bounds total daily spend for the whole app.
# TRACE_DAILY_QUERY_CAP=50
# TRACE_GLOBAL_DAILY_QUERY_CAP=100

# Lifetime free-trial queries per user on the house key. BYOK queries
# (user-supplied Anthropic key, browser-stored) bypass trial and caps.
# TRACE_FREE_QUERIES=3

# Where bare clones live. On Railway, mount a volume here (e.g. /data).
# Defaults to ./data in development.
# DATA_DIR=/data
